+/* =============================================================
+   PATCH 05 — FAVORITES: PORTRAIT-ONLY, VIEWPORT-SIZED, PAGINATED
+   Each favorite opens its existing /fighter/:id combo library.
+   On desktop, the number of rows changes with the available height.
+   ============================================================= */
+.favorites-page {
+  width:100%; max-width:1480px; margin:0 auto; min-width:0;
+  min-height:0; display:flex; flex-direction:column;
+  padding:clamp(20px,3.3vh,36px) clamp(18px,3.6vw,66px) 16px;
+}
+.favorites-heading { display:flex; align-items:end; justify-content:space-between; gap:22px; flex:0 0 auto; }
+.favorites-heading h1 { font:900 clamp(33px,3.1vw,54px)/1 Impact,'Arial Black',sans-serif; margin:7px 0 10px; }
+.favorites-heading h1 em { font-style:normal; color:#d250e1; }
+.favorites-heading p { color:#aba0ba; font-size:12px; line-height:1.4; margin:0; }
+.favorites-total { display:flex; align-items:center; gap:11px; padding-bottom:5px; flex:0 0 auto; }
+.favorites-total strong { font:50px/1 Impact,'Arial Black',sans-serif; }
+.favorites-total span { padding-left:11px; border-left:1px solid #5a436b; color:#a798bc; font-size:9px; font-weight:900; letter-spacing:1px; }
+.favorites-toolbar { display:flex; align-items:center; justify-content:space-between; gap:15px; margin:20px 0 14px; padding-bottom:13px; border-bottom:1px solid #4a365a; flex:0 0 auto; }
+.favorites-count { display:flex; align-items:center; gap:8px; color:#dc97e6; font-weight:900; font-size:10px; letter-spacing:1.1px; }
+.favorites-search { height:38px; max-width:270px; }
+.favorites-search button { display:grid; place-items:center; border:0; background:none; color:#d0a7df; padding:4px; }
+.favorites-grid-viewport { width:100%; min-height:0; flex:1 1 auto; overflow:hidden; }
+.favorites-grid { display:grid; grid-template-columns:repeat(var(--favorites-columns,6),minmax(0,1fr)); grid-auto-rows:var(--favorites-card-height,250px); align-content:start; gap:12px; }
+.favorite-card { position:relative; display:flex; flex-direction:column; overflow:hidden; min-height:0; min-width:0; background:linear-gradient(140deg,#2d223b,#191426); border:1px solid #5a3a69; transition:border-color .2s; }
+.favorite-card:hover,.favorite-card:focus-within { border-color:#d465de; }
+.favorite-card-link { position:relative; display:block; min-height:0; flex:1 1 auto; overflow:hidden; background:radial-gradient(ellipse at 52% 66%,color-mix(in srgb,var(--fighter-color) 45%,transparent),transparent 80%),#271d39; }
+.favorite-card-link .fighter-artwork--portrait { position:absolute; inset:0; }
+.favorite-card-link .fighter-artwork--portrait img { width:100%; height:100%; object-fit:cover; }
+.favorite-card-link:hover .fighter-artwork--portrait img { filter:grayscale(0) contrast(1.05) saturate(1.18); }
+.favorite-card-shade { position:absolute; pointer-events:none; inset:0; background:linear-gradient(180deg,#130a2557,transparent 35%,#140d258c); }
+.favorite-card-index { position:absolute; left:9px; top:9px; font-size:8px; letter-spacing:1px; font-weight:900; color:white; text-shadow:0 1px 8px #06020b; }
+.favorite-card-open { position:absolute; bottom:10px; right:10px; display:grid; place-items:center; width:27px; height:27px; color:#2c173d; background:#f9eaff; opacity:0; transition:opacity .15s; }
+.favorite-card-link:hover .favorite-card-open,.favorite-card-link:focus-visible .favorite-card-open { opacity:1; }
+.favorite-card-details { display:flex; flex:0 0 62px; align-items:center; justify-content:space-between; gap:6px; padding:8px 10px; border-top:1px solid #6b4573; background:#20162f; }
+.favorite-card-text { min-width:0; }

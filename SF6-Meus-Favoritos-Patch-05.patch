+.favorite-card-text p { color:#b295c7; margin:5px 0 0; font-size:8px; letter-spacing:.45px; font-weight:900; }
+.favorite-card-remove { flex:0 0 34px; height:34px; display:grid; place-items:center; border:1px solid #b35dc8; background:#543067; color:#f2a7ef; }
+.favorite-card-remove:hover { border-color:#ed73e6; background:#7d367f; color:white; }
+.favorites-empty { display:flex; width:100%; height:100%; min-height:0; flex-direction:column; align-items:center; justify-content:center; gap:15px; border:1px dashed #674279; background:linear-gradient(135deg,#1d172d,#211530); text-align:center; padding:18px; }
+.favorites-empty-icon { color:#cd63df; }

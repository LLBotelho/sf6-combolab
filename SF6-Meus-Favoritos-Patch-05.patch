+.favorites-empty .primary-button,.favorites-empty .secondary-button { margin-top:2px; }
+.favorites-pagination { display:flex; align-items:center; justify-content:space-between; gap:15px; min-height:53px; flex:0 0 53px; border-top:1px solid #4b355d; margin-top:12px; }
+.favorites-range { color:#aa98bc; font-size:10px; font-weight:900; letter-spacing:1px; }

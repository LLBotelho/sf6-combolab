+.favorites-page-controls>span strong { color:#f3d7f7; }
+.favorites-page-controls button { display:grid; place-items:center; width:35px; height:35px; border:1px solid #705080; background:#342344; color:#f7e3fd; }
+.favorites-page-controls button:hover:not(:disabled) { background:#633479; }
+.favorites-page-controls button:disabled { opacity:.25; }

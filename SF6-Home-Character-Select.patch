+/**
+ * Discovers the user's own SVG fighter illustrations under public/assets.
+ * Runs automatically before `npm run dev` and `npm run build`.
+ * No images are downloaded or modified by this script.
+ */
+import { readdir, mkdir, writeFile } from 'node:fs/promises';
+import { join, relative, resolve, sep } from 'node:path';
+
+const root = resolve('public/assets');
+const output = resolve('src/data/fighterArt.generated.ts');
+const found = [];
+
+async function visit(folder) {
+  let items;
+  try { items = await readdir(folder, { withFileTypes: true }); }
+  catch (error) {
+    if (error.code === 'ENOENT') return;
+    throw error;
+  }
+  for (const item of items) {
+    const fullPath = join(folder, item.name);
+    if (item.isDirectory()) await visit(fullPath);
+    else if (item.isFile() && item.name.toLowerCase().endsWith('.svg')) {
+      // URLs are rooted at /assets: do not put /public in the browser path.
+      const url = '/assets/' + relative(root, fullPath)
+        .split(sep).map(encodeURIComponent).join('/');
+      found.push(url);
+    }
+  }
+}
+
+await visit(root);
+found.sort((a, b) => a.localeCompare(b));
+await mkdir(resolve('src/data'), { recursive: true });
+await writeFile(output,
+  '// AUTO-GENERATED — do not hand-edit. Run `npm run artwork` to refresh.\n' +
+  'export const availableFighterSvgs: readonly string[] = ' + JSON.stringify(found, null, 2) + ';\n',
+  'utf8');
+console.log(`[character art] ${found.length} SVG(s) found under public/assets`);

+import type { Fighter } from '../types';
+import { availableFighterSvgs } from './fighterArt.generated';
+
+/** For file names that cannot be identified automatically, map a fighter ID to a public URL.
+ * Example: 'ryu': '/assets/my-folder/custom-filename.svg'
+ */
+export const fighterArtworkOverrides: Record<string, string> = {};
+
+/** Fine-tune an individual fighter's face framing (percentage and zoom).
+ * Keep the CSS defaults for everyone else. E.g. 'ryu': { x: 48, y: 9, zoom: 1.85 }
+ */
+export const portraitFraming: Record<string, { x: number; y: number; zoom: number }> = {};
+
+function normalize(value: string) {
+  return value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase().replace(/[^a-z0-9]/g, '');
+}
+
+function filePart(url: string) {
+  const decoded = decodeURIComponent(url.split('/').pop() ?? '');
+  return decoded.replace(/\.svg$/i, '');
+}
+
+function score(url: string, fighter: Fighter): number {
+  const stem = normalize(filePart(url));
+  const reduced = stem.replace(/streetfighter6|streetfighter|sf6|character|portrait|profile|render|artwork|fighter|transparent|fullbody|cutout|official|thumb|image|art/g, '').replace(/[0-9]+$/, '');
+  const aliases = [fighter.id, fighter.name];
+  if (fighter.id === 'e-honda') aliases.push('Honda');
+  if (fighter.id === 'dee-jay') aliases.push('Deejay');
+  if (fighter.id === 'm-bison') aliases.push('Bison');
+  if (fighter.id === 'c-viper') aliases.push('Viper');
+  const keys = [...new Set(aliases.map(normalize))];
+  const parent = normalize(decodeURIComponent(url.split('/').at(-2) ?? ''));
+  let best = 0;
+  for (const key of keys) {
+    if (!key) continue;
+    if (stem === key) best = Math.max(best, 100);
+    if (reduced === key) best = Math.max(best, 95);
+    if (stem === `${key}sf6` || stem === `sf6${key}`) best = Math.max(best, 94);
+    if (stem.startsWith(`${key}portrait`) || stem.startsWith(`${key}render`) || stem.startsWith(`${key}character`) || stem.startsWith(`${key}art`)) best = Math.max(best, 90);
+    if (stem.startsWith(`sf6${key}`) || stem.startsWith(`character${key}`) || stem.startsWith(`portrait${key}`) || stem.startsWith(`fighter${key}`)) best = Math.max(best, 88);
+    if (parent === key && ['portrait', 'art', 'character', 'render', 'default', 'fighter'].includes(stem)) best = Math.max(best, 87);
+    if (stem.startsWith(key) && /^([0-9]|svg|thumb|icon|profile|image|full|cutout)/.test(stem.slice(key.length))) best = Math.max(best, 82);
+  }
+  // Prefer the character-specific folders over unrelated site SVGs.
+  if (/\/(characters|fighters|roster|portraits)\//i.test(url)) best += best ? 3 : 0;
+  return best;
+}
+
+export function getFighterArtwork(fighter: Fighter): string | null {
+  if (fighterArtworkOverrides[fighter.id]) return fighterArtworkOverrides[fighter.id];
+  const matches = availableFighterSvgs
+    .map((url) => ({ url, relevance: score(url, fighter) }))
+    .filter(({ relevance }) => relevance > 0)
+    .sort((a, b) => b.relevance - a.relevance || a.url.length - b.url.length);
+  if (matches.length) return matches[0].url;
+  // Keep the one supplied raster reference until a matching SVG is found.
+  return fighter.isReferenceArt ? '/assets/honda-reference.png' : null;
+}

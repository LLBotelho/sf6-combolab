 @media (prefers-reduced-motion:reduce) { .select-stage-portrait,.select-stage-information { animation:none; } }
+
+/* =============================================================
+   FIGHTER PAGE V2 — SCREEN-FIT PLAYBOOK
+   Desktop: single viewport, prominent SVG, no document scrolling.
+   The editor remains a separate modal and is unaffected.
+   ============================================================= */
+.fighter-page--playbook {
+  width:100%; max-width:1540px; margin:0 auto; padding:18px 30px 25px;
+  display:grid; grid-template-columns:minmax(290px,36fr) minmax(0,64fr);
+  gap:19px; min-width:0; align-items:stretch;
+}
+.fighter-showcase {
+  min-width:0; min-height:0; isolation:isolate; position:relative;
+  display:flex; flex-direction:column; justify-content:space-between;
+  overflow:hidden; padding:24px;
+  border:1px solid color-mix(in srgb,var(--fighter-color) 38%,#46355f);
+  background:radial-gradient(ellipse 115% 85% at 55% 40%,color-mix(in srgb,var(--fighter-color) 23%,#1c1635),transparent 84%),
+             repeating-linear-gradient(117deg,transparent 0 95px,#ffffff04 96px 97px),
+             linear-gradient(165deg,#271c3b,#120e23 82%);
+}
+.fighter-showcase:before { content:''; z-index:-1; pointer-events:none; position:absolute; inset:0; background:linear-gradient(180deg,#0d091ba8 0,transparent 28%,transparent 52%,#0b0819 99%); }
+.fighter-showcase:after { content:'FIGHTER'; z-index:-1; pointer-events:none; position:absolute; right:-24px; top:19%; writing-mode:vertical-rl; font:120px/.8 Impact,sans-serif; color:#ffffff07; }
+.showcase-art { position:absolute; z-index:-2; inset:8% -8% 10%; pointer-events:none; }
+.showcase-art .fighter-artwork--stage { width:100%; height:100%; }
+.showcase-art .fighter-artwork--stage img { width:100%; height:100%; object-fit:contain; object-position:center bottom; filter:drop-shadow(0 18px 21px #03020d9c) saturate(1.16); }
+.showcase-art .fighter-artwork--stage .fighter-artwork-fallback { font-size:clamp(145px,17vw,310px); }
+.showcase-top,.showcase-bottom { position:relative; z-index:1; }
+.showcase-top { display:flex; flex-direction:column; gap:17px; }
+.showcase-back { display:inline-flex; width:max-content; align-items:center; gap:9px; color:#f2d8fd; font-size:10px; letter-spacing:1.4px; font-weight:900; }
+.showcase-back:hover { color:white; }
+.showcase-top .eyebrow { color:#dbc0e8; line-height:1.5; text-shadow:0 2px 8px #0d081a; }
+.showcase-number { font-size:10px; font-weight:900; letter-spacing:1.6px; color:#d6b2dd; text-shadow:0 2px 10px #080511; }
+.showcase-bottom h1 { margin:8px 0 17px; overflow-wrap:anywhere; font:clamp(55px,5.4vw,92px)/.95 Impact,'Arial Black',sans-serif; text-shadow:0 5px 21px #03020ee8; }
+.showcase-stats { display:flex; gap:0; border-top:1px solid #b68aaa66; padding-top:15px; }
+.showcase-stats>div { display:flex; flex-direction:column; gap:4px; min-width:0; flex:1; padding:0 8px; border-right:1px solid #ffffff35; }
+.showcase-stats>div:first-child { padding-left:0; }
+.showcase-stats>div:last-child { border-right:0; }
+.showcase-stats strong { font:29px/.95 Impact,sans-serif; color:#faf0ff; }
+.showcase-stats span { color:#ccbad5; letter-spacing:1px; font-size:9px; font-weight:850; }
+.playbook-panel {
+  background:linear-gradient(155deg,#1c152d,#130f22 65%);
+  border:1px solid #453152; min-width:0; min-height:0;
+  display:flex; flex-direction:column; overflow:hidden; padding:23px 24px 14px;
+}
+.playbook-header { display:flex; gap:15px; align-items:center; justify-content:space-between; min-width:0; padding-bottom:17px; border-bottom:1px solid #4b355a; }
+.playbook-titles { min-width:0; }
+.playbook-titles h2 { margin:7px 0 4px; font:clamp(34px,3.5vw,53px)/1 Impact,'Arial Black',sans-serif; white-space:nowrap; }
+.playbook-titles p { font-size:11px; margin:5px 0 0; color:#a89dbb; line-height:1.4; }
+.playbook-actions { display:flex; flex-direction:column; gap:7px; align-items:stretch; flex-shrink:0; }
+.playbook-actions button { min-height:37px; padding:8px 13px; font-size:9px; justify-content:center; }
+.playbook-actions .main-toggle[aria-pressed='true'] { background:#4c225a; color:#ffbdf6; border-color:#a64da2; }
+.playbook-toolbar { display:grid; grid-template-columns:minmax(205px,1.1fr) minmax(120px,1fr); gap:10px; margin-top:14px; }
+.category-select { display:flex; min-width:0; position:relative; align-items:center; gap:9px; height:38px; padding:0 11px; color:#c997e4; background:#261c39; border:1px solid #664677; }
+.category-select select { appearance:none; background:transparent; cursor:pointer; border:0; outline:0; flex:1; min-width:0; width:100%; padding-right:14px; font-size:11px; font-weight:750; color:#f9f0ff; }
+.category-select select option { background:#241832; color:#fff; }
+.category-select:focus-within { outline:2px solid var(--cyan); outline-offset:2px; }
+.category-chevron { pointer-events:none; position:absolute; right:8px; color:#b9a4cc; }
+.playbook-toolbar .combo-search { width:auto; max-width:none; min-width:0; margin:0; height:38px; }
+.playbook-tags { display:flex; justify-content:space-between; align-items:center; min-height:47px; gap:10px; }
+.playbook-tags .tag-filters { min-width:0; }
+.playbook-tags .tag-filters button { padding:8px 9px; font-size:9px; white-space:nowrap; }
+.playbook-count { font-size:9px; font-weight:850; color:#8f819d; letter-spacing:1px; white-space:nowrap; }
+.playbook-results { display:flex; flex:1; min-height:0; flex-direction:column; position:relative; }
+.combo-page-window { position:relative; flex:1; min-height:0; overflow:hidden; }
+.combo-list--paged,.combo-measure { display:grid; gap:9px; align-content:start; }
+.combo-measure { position:absolute; left:0; right:0; top:0; visibility:hidden; pointer-events:none; z-index:-1; }
+.combo-card--compact { min-width:0; overflow:hidden; }
+.combo-card--compact .combo-card-head { padding:8px 11px; min-height:47px; gap:10px; }
+.combo-card--compact .combo-number { font-size:22px; }
+.combo-card--compact .combo-heading h3 { font-size:13px; line-height:1.35; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.combo-card--compact .combo-meta { font-size:8px; line-height:1.35; }
+.combo-card--compact .icon-button { min-height:27px; min-width:27px; }
+.combo-card--compact .combo-card-body { margin:0 10px; padding:5px 7px; height:67px; overflow:hidden; }
+.combo-card--compact .combo-sequence { max-height:57px; overflow:hidden; align-content:flex-start; gap:2px 3px; }
+.combo-card--compact .command-icon { height:26px; width:26px; }
+.combo-card--compact .command-icon--motion { width:81px; }
+.combo-card--compact .command-icon--motion:has(.command-text-icon) { width:102px; }
+.combo-card--compact .command-icon--system { width:46px; }
+.combo-card--compact .command-icon--separator { width:19px; }
+.combo-card--compact .combo-token { padding:0 1px; }
+.combo-card--compact .combo-card-foot { padding:4px 10px 7px; gap:7px; min-height:22px; flex-wrap:nowrap; }
+.combo-card--compact .combo-tags { flex:0 0 auto; gap:4px; }
+.combo-card--compact .tag { padding:2px 5px; font-size:9px; }
+.combo-card--compact .combo-notes { min-width:0; white-space:nowrap; text-overflow:ellipsis; overflow:hidden; font-size:10px; }
+.combo-view-full { color:#da91f3; display:flex; align-items:center; gap:5px; padding:3px 11px 4px; font-size:9px; letter-spacing:.6px; font-weight:800; }
+.combo-view-full:hover { color:#fff; }
+.combo-pagination { display:grid; flex:0 0 auto; grid-template-columns:1fr auto 1fr; align-items:center; gap:10px; min-height:46px; margin-top:7px; border-top:1px solid #4d3459; }
+.page-caption { font-size:9px; font-weight:850; letter-spacing:1px; color:#9d8cad; }
+.page-caption--right { text-align:right; }
+.page-navigation { display:flex; align-items:center; gap:11px; color:#f9f3ff; font-size:12px; font-weight:850; }
+.page-navigation button { width:31px; height:31px; display:grid; place-items:center; border:1px solid #694477; background:#2b1f3d; color:#f9eaff; }
+.page-navigation button:hover:not(:disabled) { background:#67377b; }
+.page-navigation button:disabled { opacity:.27; }
+.page-slash { color:#806a90; margin:0 5px; }
+.empty-combos--playbook { flex:1; min-height:0; width:100%; justify-content:center; padding:25px 16px; gap:12px; }
+.empty-combos--playbook h3 { font-size:clamp(21px,2.3vw,30px); }
+.empty-combos--playbook .empty-combos-icon { font-size:30px; }
+.empty-combos--playbook p { margin:0; }
+/* Only a detail dialog may scroll when a combo is too long for its card. */
+.combo-detail-backdrop { position:fixed; z-index:95; inset:0; display:flex; align-items:center; justify-content:center; padding:22px; background:#06040ce3; backdrop-filter:blur(8px); }
+.combo-detail-dialog { width:min(850px,100%); max-height:min(720px,calc(100dvh - 44px)); display:flex; flex-direction:column; min-height:0; overflow:hidden; background:#191227; border:1px solid #a05cc0; box-shadow:0 25px 90px #000b; }
+.combo-detail-dialog>header { display:flex; align-items:start; justify-content:space-between; padding:20px 24px; border-bottom:1px solid #564066; gap:15px; }
+.combo-detail-dialog h2 { font:30px/1.2 Impact,sans-serif; margin:8px 0 0; overflow-wrap:anywhere; }
+.combo-detail-content { overflow-y:auto; padding:23px 24px 30px; min-height:0; }
+.combo-detail-overline { font-size:10px; color:#c6b1d6; letter-spacing:1px; font-weight:850; }
+.combo-detail-sequence { margin:14px 0 20px; padding:18px; background:#291e3c; border:1px solid #573f6d; }
+.combo-detail-sequence .combo-sequence { gap:8px; }
+.combo-detail-tags { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px; }
+.combo-detail-content h3 { font-size:10px; letter-spacing:1px; color:#e093ed; margin-bottom:9px; font-weight:900; }
+.combo-detail-notes { color:#c7b7d3; font-size:13px; line-height:1.7; white-space:pre-wrap; overflow-wrap:anywhere; }
+
+@media (min-width:1060px) and (min-height:640px) {
+  .app-shell:has(> .fighter-page--playbook) { height:100dvh; min-height:0; overflow:hidden; }
+  .app-shell:has(> .fighter-page--playbook) .site-header { flex:0 0 77px; }
